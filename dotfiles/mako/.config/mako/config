include=~/.config/mako/colors

# Global Style
max-history=100
sort=-time

# --- Look & Feel ---
# Shared tokens: 10px container radius, 1px border, Iosevka + NF icon fallback
width=300
height=110
margin=10
padding=15
border-size=1
border-radius=10
font=Iosevka, JetBrainsMono NF 10
default-timeout=5000

# Icons
icons=1
max-icon-size=48

[urgency=high]
default-timeout=0
